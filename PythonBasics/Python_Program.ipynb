# Write a program to implement function and modules.

import math

def calculate_square_root(num):
    return math.sqrt(num)

number = int(input("Enter number for square root : "))

if number > 0:
    result = calculate_square_root(number)
    print("Square root of {} is {}".format(number, result))
else:
    print("Enter a positive number greater than zero")
